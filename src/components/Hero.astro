---
import Invitation from '@/components/Invitation.astro'

interface ThemeLink {
  id: string
  number: string
  title: string
}

interface Props {
  themes: ThemeLink[]
}

const { themes } = Astro.props
---

<section
  id="landing"
  class="wedding-hero bg-background flex min-h-screen flex-col items-center justify-center px-6 pt-20 text-center"
>
  <canvas id="wedding-canvas" aria-hidden="true"></canvas>
  <div class="hero-shade" aria-hidden="true"></div>
  <audio id="wedding-music" src="/audio/there-is-romance.mp3" preload="none" autoplay loop></audio>
  <p class="hero-eyebrow mt-50 mb-8 text-[10px] tracking-[0.35em] text-white uppercase">
    A collection of moments
  </p>

  <Invitation />
  <div class="bg-border mx-auto mb-6 h-px w-12"></div>
  <p class="max-w-xs text-sm leading-relaxed text-white">
    Four themes, one story — scroll to discover each chapter of love beautifully captured.
  </p>

  <!-- Theme quick links -->
  <div class="mt-12 grid grid-cols-2 gap-3 sm:flex sm:gap-6">
    {themes.map((t) => (
      <a
        href={`#${t.id}`}
        class="border-border border px-4 py-2.5 text-[10px] tracking-[0.2em] text-white/70 uppercase transition-all duration-200 hover:border-white/30 hover:text-white"
      >
        {t.number} {t.title}
      </a>
    ))}
  </div>

  <a
    href="#dark-elegant"
    class="group mt-14 flex flex-col items-center gap-2 text-white transition-colors hover:text-white"
  >
    <span class="text-[10px] tracking-[0.25em] uppercase">Scroll</span>
    <span class="block h-10 w-px bg-white/30 transition-colors group-hover:bg-white/50"></span>
  </a>
</section>

<script>
  import { initWeddingHero } from '@/scripts/wedding-hero'

  initWeddingHero()
</script>

<style>
  .wedding-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* Clip viewport-fixed layers at this section's scrolling boundary. */
    clip-path: inset(0);
    min-height: 100svh;
    padding-bottom: 2rem;
  }

  #wedding-canvas,
  .hero-shade {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
  }

  .hero-shade {
    background: linear-gradient(180deg, #17152510 25%, #17152536 52%, #171525b8 100%);
  }

  .wedding-hero::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background:
      linear-gradient(to right bottom, rgba(83, 81, 124, 0.1), rgba(83, 81, 124, 0.1)),
      url('/kk_00232-mobile.webp') no-repeat 48% center/cover;
  }

  .hero-eyebrow {
    margin-top: clamp(15rem, 40svh, 32rem);
  }

  section.bg-background {
    background: transparent;
  }

  @media (min-width: 768px) {
    .wedding-hero::before {
      background:
        linear-gradient(to right bottom, rgba(83, 81, 124, 0.1), rgb(83, 81, 124, 0.1)),
        url('/kk_00232-web.webp') no-repeat center/cover;
    }
  }
</style>
