{
  "name": "wedding-dvgamerr",
  "version": "1.2.0",
  "type": "module",
  "dependencies": {
    "@astrojs/mdx": "^7.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@cronitorio/cronitor-rum": "^0.4.2",
    "astro": "^7.2.3",
    "astro-google-fonts-optimizer": "^0.2.2",
    "astro-seo": "^1.1.0",
    "dayjs": "^1.11.23"
  },
  "private": true,
  "scripts": {
    "dev": "bun x --bun astro dev",
    "start": "bun x --bun astro dev",
    "build": "bun x --bun astro build",
    "preview": "bun x --bun astro preview",
    "astro": "bun x --bun astro",
    "lint": "bun x --bun eslint . --max-warnings=0",
    "format": "bun x --bun prettier --write .",
    "format:check": "bun x --bun prettier --check .",
    "prepare": "bun x --bun husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "astro-compress": "^2.4.3",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-eslint": "^17.1.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  }
}
